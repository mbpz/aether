; .npmrc
;
; Aether npm publish + install defaults.
; See: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc
;
; Provenance: signed attestation linking the published tarball to
; the source repo + workflow run. Consumers can verify with
; `npm view @aether/sandbox dist.integrity`.
provenance=true

; Save exact versions in package-lock.json (no ^/~) — more
; reproducible installs. B0 set this; keep it.
save-exact=true

; Registry defaults to npmjs.org. Override with --registry for
; private registries.
registry=https://registry.npmjs.org/

; Don't auto-install funding messages.
fund=false

; Engine-strict: refuse install if Node < 20.
engine-strict=true

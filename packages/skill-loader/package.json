{
  "name": "@aether/skill-loader",
  "version": "0.1.0",
  "description": "Aether skill system — progressive three-tier disclosure, SKILL.md + OpenClaw + Manus + Skillpack formats, security auditor + ZTA scoring.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "development": "./src/parser/skill-parser.ts",
      "default": "./dist/parser/skill-parser.js"
    },
    "./audit": {
      "development": "./src/audit/skill-auditor.ts",
      "default": "./dist/audit/skill-auditor.js"
    }
  },
  "bin": {
    "skill-audit": "./bin/skill-audit.js"
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aether/aether.git",
    "directory": "packages/skill-loader"
  },
  "bugs": {
    "url": "https://github.com/aether/aether/issues"
  },
  "homepage": "https://github.com/aether/aether/tree/main/packages/skill-loader#readme",
  "keywords": [
    "skill-loader",
    "SKILL.md",
    "Manus",
    "OpenClaw",
    "Skillpack",
    "progressive-disclosure",
    "ZTA",
    "security-scoring"
  ]
}

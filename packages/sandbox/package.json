{
  "name": "@aether/sandbox",
  "version": "0.1.0",
  "description": "Aether sandbox execution layer — V8 Isolate (fail-closed), Wasmtime-ready, EbpfFirewall + EbpfPolicySync. ADR-001/002/006.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./security": {
      "development": "./src/security/policy.ts",
      "default": "./dist/security/policy.js"
    },
    "./codeact": {
      "development": "./src/codeact/engine.ts",
      "default": "./dist/codeact/engine.js"
    }
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "dotenv": "^16.4.5",
    "isolated-vm": "^4.7.2",
    "js-yaml": "^4.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aether/aether.git",
    "directory": "packages/sandbox"
  },
  "bugs": {
    "url": "https://github.com/aether/aether/issues"
  },
  "homepage": "https://github.com/aether/aether/tree/main/packages/sandbox#readme",
  "keywords": [
    "sandbox",
    "V8-Isolate",
    "Wasmtime",
    "isolated-vm",
    "eBPF",
    "XDP",
    "fail-closed",
    "OWASP-Agentic"
  ]
}
